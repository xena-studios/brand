{
  "name": "xena-brand",
  "version": "1.0.0",
  "description": "Xena Studios brand system: the studio, Raptor, NeoSkript, MostWanted, Airfields and the plugin family",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:logos": "node scripts/build.ts --logos",
    "build:airfields": "node scripts/airfields-brand.ts",
    "build:plugins": "node scripts/build.ts --plugins",
    "build:badges": "node scripts/badges.ts",
    "dev": "node --watch scripts/build.ts --preview",
    "preview": "node scripts/preview.ts",
    "check": "node scripts/build.ts --force && git diff --exit-code --stat -- . ':!pnpm-lock.yaml' && git ls-files --others --exclude-standard | (! grep .)",
    "typecheck": "tsc",
    "verify": "tsc && node scripts/verify.ts",
    "catalog": "node scripts/catalog.ts",
    "new-plugin": "node scripts/new-plugin.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xena-studios/brand.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/xena-studios/brand/issues"
  },
  "homepage": "https://github.com/xena-studios/brand#readme",
  "devDependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
