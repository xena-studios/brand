{
  "name": "xena-brand",
  "version": "1.0.0",
  "description": "Xena Studios brand system: the studio, Raptor, NeoSkript, MostWanted and the plugin family",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/build.ts && git diff --exit-code --stat -- . ':!pnpm-lock.yaml' && git ls-files --others --exclude-standard | (! grep .)",
    "typecheck": "tsc",
    "verify": "tsc && node scripts/verify.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xena-studios/brand.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/xena-studios/brand/issues"
  },
  "homepage": "https://github.com/xena-studios/brand#readme",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
