---
import type { Swatch } from "../lib/brands.ts";

interface Props {
  colours: Swatch[];
}

const { colours } = Astro.props;
---
<ul class="swatches">
  {
    colours.map((c) => (
      <li>
        <svg viewBox="0 0 10 10" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect width="10" height="10" fill={c.hex} /></svg>
        <div>
          <span>{c.name}</span>
          <code>{c.hex}</code>
        </div>
      </li>
    ))
  }
</ul>
